rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(userRef())
        && get(userRef()).data.isadmin == true;
    }

    function isDriver() {
      return signedIn()
        && exists(userRef())
        && get(userRef()).data.isDriver == true;
    }

    function ownsUserRef(data) {
      return signedIn() && data.userRef == userRef();
    }

    match /users/{document} {
      allow create: if signedIn() && request.auth.uid == document;
      allow read: if signedIn() && (request.auth.uid == document || isAdmin());
      allow update: if signedIn() && (request.auth.uid == document || isAdmin());
      allow delete: if signedIn() && (request.auth.uid == document || isAdmin());
    }

    match /products/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /cart/{document} {
      allow create: if ownsUserRef(request.resource.data);
      allow read, update, delete: if signedIn()
        && (isAdmin() || ownsUserRef(resource.data));
    }

    match /orders/{document} {
      allow create: if ownsUserRef(request.resource.data);
      allow read, update: if signedIn()
        && (isAdmin() || isDriver() || ownsUserRef(resource.data));
      allow delete: if isAdmin();
    }

    match /orders/{parent}/ordersitems/{document} {
      allow create, read, update: if signedIn()
        && (isAdmin() || isDriver() || ownsUserRef(get(/databases/$(database)/documents/orders/$(parent)).data));
      allow delete: if isAdmin();
    }

    match /{path=**}/ordersitems/{document} {
      allow read: if signedIn();
    }


    match /app_config/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /recipes/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /driverLocations/{document} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == document);
      allow create, update, delete: if signedIn()
        && request.auth.uid == document
        && isDriver();
    }

    match /ff_user_push_notifications/{id} {
      allow read, update, delete: if false;
      allow create: if signedIn() && userRef() == request.resource.data.sender;
    }
  }
}
